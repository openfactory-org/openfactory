// The GitLab plugin Worker. The control plane binds it as PLUGIN_GITLAB with
// entrypoint "Plugin" (apps/control-plane/wrangler.jsonc). It holds no team
// secrets: integration settings and tokens come from the control plane per call.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openfactory-plugin-gitlab",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  // Reached only through the service binding.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "PLUGIN_VERSION": "0.0.0-dev" },
}
