{
  "$id": "https://openfactory-org.github.io/schemas/v1/benchmark_suite_task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "benchmarks/<suite-slug>/tasks/<task-slug>.yaml.",
  "properties": {
    "linearSeed": {
      "description": "Older name of trackerSeed. Set only one of them."
    },
    "prompt": {
      "description": "Prompt of the trial.",
      "minLength": 1,
      "type": "string"
    },
    "sourceRunId": {
      "description": "Run that the task reproduces.",
      "minLength": 1,
      "type": "string"
    },
    "startingRepoRefs": {
      "description": "Commits that the trial starts from. Each entry is a string github.com:OWNER/REPO@SHA or gitlab.com:OWNER/REPO@SHA, or an object {codeForge, owner, repo, ref}. codeForge is GITHUB or GITLAB. ref is a full 40-character lowercase commit SHA.",
      "items": {
        "anyOf": [
          {
            "pattern": "^(github\\.com|gitlab\\.com):[^@\\s]+/[^@/\\s]+@[0-9a-f]{40}$",
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "codeForge": {
                "enum": [
                  "GITHUB",
                  "GITLAB"
                ],
                "type": "string"
              },
              "owner": {
                "minLength": 1,
                "type": "string"
              },
              "ref": {
                "pattern": "^[0-9a-f]{40}$",
                "type": "string"
              },
              "repo": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "codeForge",
              "owner",
              "repo",
              "ref"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "successCriteria": {
      "description": "What the trial must do to pass.",
      "minLength": 1,
      "type": "string"
    },
    "tags": {
      "description": "Free-form tags.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "description": "Title of the task.",
      "minLength": 1,
      "type": "string"
    },
    "trackerSeed": {
      "description": "The start state of the tracker for the trial. Any YAML value."
    }
  },
  "required": [
    "title",
    "prompt",
    "successCriteria"
  ],
  "title": "Benchmark task",
  "type": "object"
}
