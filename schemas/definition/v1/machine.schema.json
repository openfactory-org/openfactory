{
  "$id": "https://openfactory-org.github.io/schemas/v1/machine.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "machines/<name>.yaml: compute for agent runs.",
  "properties": {
    "description": {
      "description": "Short description of the machine.",
      "type": "string"
    },
    "failureSessionRetentionMinutes": {
      "description": "Minutes that the sandbox of a failed run is kept. Without a value, the sandbox is released at once.",
      "maximum": 60,
      "minimum": 1,
      "type": "integer"
    },
    "instanceShape": {
      "additionalProperties": false,
      "description": "CPU and memory of the sandbox. For linux and windows, both values must be powers of two. For macos, the shape must be 4/7, 6/14, 8/14, 12/28 or 12/56 (vCPUs/GB).",
      "properties": {
        "memoryGb": {
          "description": "Memory in GB.",
          "minimum": 1,
          "type": "integer"
        },
        "vcpus": {
          "description": "Number of virtual CPUs.",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "vcpus",
        "memoryGb"
      ],
      "type": "object"
    },
    "platform": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "os": {
                "const": "macos"
              }
            },
            "required": [
              "os"
            ]
          },
          "then": {
            "not": {
              "required": [
                "linux"
              ]
            },
            "properties": {
              "arch": {
                "const": "aarch64"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "os": {
                "const": "windows"
              }
            },
            "required": [
              "os"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "linux"
                  ]
                },
                {
                  "required": [
                    "mac"
                  ]
                }
              ]
            },
            "properties": {
              "arch": {
                "const": "x86_64"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "os": {
                    "const": "linux"
                  }
                },
                "required": [
                  "os"
                ]
              },
              {
                "not": {
                  "required": [
                    "os"
                  ]
                }
              }
            ]
          },
          "then": {
            "not": {
              "required": [
                "mac"
              ]
            },
            "required": [
              "linux"
            ]
          }
        }
      ],
      "description": "Operating system, architecture and image of the sandbox.",
      "properties": {
        "arch": {
          "description": "CPU architecture. macos allows only aarch64. windows allows only x86_64. Default: x86_64, or aarch64 for macos.",
          "enum": [
            "x86_64",
            "aarch64"
          ],
          "type": "string"
        },
        "linux": {
          "additionalProperties": false,
          "description": "Linux settings. Required when os is linux, and allowed only then.",
          "properties": {
            "image": {
              "description": "Container image of the sandbox. No spaces or tabs.",
              "minLength": 1,
              "type": "string"
            },
            "registryCredentialSecretName": {
              "$ref": "common.schema.json#/$defs/secretName",
              "description": "Secret with the credential to pull a private image. The kubernetes backend ignores it and pulls with the imagePullSecrets of the pod template."
            },
            "user": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "const": "image"
                }
              ],
              "default": 1000,
              "description": "User of the sandbox on the kubernetes backend. A number sets runAsUser, runAsGroup and fsGroup. image keeps the user of the image. Root (0) is not allowed."
            }
          },
          "required": [
            "image"
          ],
          "type": "object"
        },
        "mac": {
          "additionalProperties": false,
          "description": "macOS settings. Allowed only when os is macos.",
          "properties": {
            "version": {
              "default": "26",
              "description": "macOS version. Quote the value.",
              "enum": [
                "14",
                "15",
                "26",
                "27"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "os": {
          "default": "linux",
          "description": "Operating system of the sandbox.",
          "enum": [
            "linux",
            "macos",
            "windows"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "setupCommands": {
      "description": "Commands that run in order after the repositories are checked out.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "platform"
  ],
  "title": "Machine",
  "type": "object"
}
