{
  "$defs": {
    "codeForge": {
      "enum": [
        "GITHUB",
        "GITLAB",
        "AZURE_DEVOPS"
      ],
      "type": "string"
    },
    "credential": {
      "enum": [
        "EXECUTOR",
        "CREATOR"
      ],
      "type": "string"
    },
    "harness": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/harnessAuth"
            },
            {
              "type": "null"
            }
          ],
          "description": "Model credential of the harness. null clears the inherited credential."
        },
        "model": {
          "$ref": "common.schema.json#/$defs/model",
          "description": "Model name. The harness gets it as it is."
        },
        "reasoningLevel": {
          "description": "Reasoning level that the harness passes to the model.",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "type": "string"
        },
        "type": {
          "$ref": "common.schema.json#/$defs/harnessType",
          "description": "Harness that runs the agent. claude-code is an alias of claude."
        }
      },
      "required": [
        "type",
        "model"
      ],
      "type": "object"
    },
    "harnessAuth": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "managedSecret"
              }
            }
          },
          "then": {
            "required": [
              "secretName"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "workerEnvironment"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "secretName"
              ]
            }
          }
        }
      ],
      "properties": {
        "secretName": {
          "$ref": "common.schema.json#/$defs/secretName",
          "description": "Secret that holds the credential. Required for managedSecret. Not allowed for workerEnvironment."
        },
        "source": {
          "description": "Where the credential comes from. managedSecret reads a secret. workerEnvironment uses the environment of a self-hosted worker, so the effective workerHost must not be empty.",
          "enum": [
            "managedSecret",
            "workerEnvironment"
          ],
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "harnessOverride": {
      "additionalProperties": false,
      "description": "Sparse override of the inherited harness. Set auth to null to clear inherited authentication.",
      "properties": {
        "auth": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/harnessAuth"
            },
            {
              "type": "null"
            }
          ],
          "description": "Model credential of the harness. null clears the inherited credential."
        },
        "model": {
          "$ref": "common.schema.json#/$defs/model",
          "description": "Model name. The harness gets it as it is."
        },
        "reasoningLevel": {
          "description": "Reasoning level that the harness passes to the model.",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "type": "string"
        },
        "type": {
          "$ref": "common.schema.json#/$defs/harnessType",
          "description": "Harness that runs the agent. claude-code is an alias of claude."
        }
      },
      "type": "object"
    },
    "harnessType": {
      "enum": [
        "claude",
        "codex",
        "claude-code"
      ],
      "type": "string"
    },
    "host": {
      "anyOf": [
        {
          "maxLength": 254,
          "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?(?:\\.[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?)*\\.?$",
          "type": "string"
        },
        {
          "pattern": "^[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*$",
          "type": "string"
        }
      ]
    },
    "mcpServer": {
      "additionalProperties": false,
      "dependentRequired": {
        "allowWrite": [
          "managedId"
        ],
        "args": [
          "command"
        ],
        "env": [
          "command"
        ],
        "headers": [
          "url"
        ]
      },
      "oneOf": [
        {
          "required": [
            "managedId"
          ]
        },
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "allowWrite": {
          "default": false,
          "description": "Enables the write tools of a built-in integration server. Valid only with managedId builtin/<provider>.",
          "type": "boolean"
        },
        "args": {
          "description": "Arguments of command. Valid only with command.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "description": "Executable that starts inside the sandbox. The server uses the stdio transport.",
          "minLength": 1,
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables of command. Valid only with command. Values can use {{SECRET}} placeholders.",
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "HTTP headers of url. Valid only with url. Values can use {{SECRET}} placeholders.",
          "type": "object"
        },
        "managedId": {
          "description": "Name or ID of a server in the MCP server registry of the team, or a built-in server: builtin/jira, builtin/linear, builtin/slack or builtin/teams. An unknown builtin/ server is an error.",
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "description": "Absolute http or https URL with a host. The server uses streamable HTTP, or legacy SSE when the path ends in /sse.",
          "pattern": "^https?://[^/\\s]+",
          "type": "string"
        }
      },
      "type": "object"
    },
    "mcpServers": {
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/mcpServer"
      },
      "propertyNames": {
        "not": {
          "const": "factory"
        },
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      },
      "type": "object"
    },
    "model": {
      "description": "A model name that the harness CLI accepts.",
      "minLength": 1,
      "type": "string"
    },
    "networkPolicy": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "allowedHosts": {
              "description": "Hosts that the run can reach: host names or literal IP addresses. No URLs, ports, CIDR ranges or wildcards. Stored in lowercase. Duplicates are removed.",
              "items": {
                "$ref": "common.schema.json#/$defs/host"
              },
              "type": "array"
            },
            "deniedHosts": {
              "description": "Hosts that the run cannot reach. The rules of allowedHosts apply. A host that any level denies is removed.",
              "items": {
                "$ref": "common.schema.json#/$defs/host"
              },
              "type": "array"
            },
            "extends": {
              "anyOf": [
                {
                  "pattern": "^builtin/[a-z0-9-]+@(latest|\\^[0-9]+(\\.[0-9]+){0,2}|[0-9]+\\.[0-9]+\\.[0-9]+)$",
                  "type": "string"
                },
                {
                  "items": {
                    "pattern": "^builtin/[a-z0-9-]+@(latest|\\^[0-9]+(\\.[0-9]+){0,2}|[0-9]+\\.[0-9]+\\.[0-9]+)$",
                    "type": "string"
                  },
                  "type": "array",
                  "uniqueItems": true
                }
              ],
              "description": "Built-in policies to start from, for example builtin/package-registries@^1, builtin/claude-code@1.0.0 or builtin/codex@latest. Each reference must resolve."
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "resourceName": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    },
    "secretList": {
      "items": {
        "$ref": "common.schema.json#/$defs/secretName"
      },
      "type": "array",
      "uniqueItems": true
    },
    "secretName": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
      "type": "string"
    }
  },
  "$id": "https://openfactory-org.github.io/schemas/v1/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Shared field definitions referenced by the other v1 schemas.",
  "title": "Open Factory common definitions"
}
