{
  "name": "openfactory-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Open Factory dashboard (React). Built into internal/webui/dist and embedded in the openfactory binary.",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../internal/api/openapi.json -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../internal/api/openapi.json -o src/api/schema.d.ts --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run gen:api && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.62.7",
    "cmdk": "1.1.1",
    "lucide-react": "1.73.0",
    "openapi-fetch": "0.13.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
