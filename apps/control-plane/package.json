{
  "name": "@openfactory/control-plane",
  "version": "0.0.0",
  "private": false,
  "description": "Open Factory control plane: Worker, Durable Objects, wrangler.jsonc.",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/dts/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dts/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/dts/src/builder.d.ts",
      "default": "./dist/builder.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/builder.js",
    "dist/builder.js.map",
    "dist/chunks",
    "dist/dts",
    "wrangler.jsonc",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "cf-types": "wrangler types --include-runtime=false --env-interface WranglerEnv worker-configuration.d.ts",
    "build": "node scripts/build.mjs && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.6",
    "@noble/curves": "2.4.0",
    "jose": "6.2.18",
    "lossless-json": "4.3.4",
    "yaml": "2.9.1"
  }
}
